# Staging: production-like. Real Supabase project (separate from production), real Resend domain, HTTPS only.
NODE_ENV=staging
APP_URL=https://staging.your-domain.example
TRUST_PROXY_HOPS=2   # Render load balancer + Vercel rewrite (use 1 if the browser calls Render directly)
COOKIE_SECURE=true
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=EWB Bank <no-reply@staging.your-domain.example>
SUPPORT_EMAIL=support@staging.your-domain.example
LEDGER_MODE=simulated
ALLOW_SEED=true   # staging may be seeded with test data; never enable in production
