# Production. The API refuses to start if any of the required values below is missing or weak (see assertConfig).
NODE_ENV=production
APP_URL=https://app.your-domain.example
TRUST_PROXY=true
COOKIE_SECURE=true
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=EWB Bank <no-reply@your-domain.example>
SUPPORT_EMAIL=support@your-domain.example
# Keep "simulated" until every item in docs/COMPLIANCE.md is satisfied. "live" is hard-blocked in code today.
LEDGER_MODE=simulated
ALLOW_SEED=false
