{
  "name": "ewb-bank-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EWB Bank API - internal software ledger with provider abstractions for future regulated integrations",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:status": "node src/db/migrate.js --status",
    "seed:admin": "node src/db/seeds/create-admin.js",
    "seed:dev": "node src/db/seeds/dev.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "test:pg": "node tests/pg-wire/run.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@node-rs/argon2": "^2.2.1",
    "@simplewebauthn/server": "^14.0.3",
    "@supabase/supabase-js": "^2.117.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "multer": "^2.4.0",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11",
    "supertest": "^7.3.1"
  }
}
