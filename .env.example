# ─────────────────────────────────────────────────────────────────────────────
# EWB Bank — environment template. PLACEHOLDERS ONLY: never put real values in this file (it is committed).
# Copy to backend/.env (or to the repository root as .env); both are found automatically in development and both are
# git-ignored. In staging/production do NOT use a file: set these variables in the Render dashboard (render.yaml lists them).
# Frontend variables live in frontend/.env.example (Vercel). Full guide: DEPLOYMENT.md
# Secrets below are SERVER-SIDE ONLY. The frontend has no environment secrets at all.
# Per-environment starting points: .env.development.example, .env.staging.example, .env.production.example
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development            # development | staging | production | test
PORT=4000
APP_URL=http://localhost:5173   # public origin of the web app (CORS, CSRF origin check, WebAuthn, email links)
CORS_ORIGINS=                   # optional, comma-separated; defaults to APP_URL
TRUST_PROXY_HOPS=0              # number of reverse proxies in front of the API: Render alone = 1, Vercel rewrite -> Render = 2
COOKIE_SAMESITE=strict          # strict (default; same-origin or Vercel rewrite) | none (direct cross-site API, needs COOKIE_SECURE=true)
# ENV_FILE=                     # optional explicit path to an env file (development only unless set)
# DB_SSL_CA=                   # optional: PEM text of the Supabase CA to fully verify the database certificate (
 for newlines)
# DB_SSL=false                  # TLS to the database is on for every non-local host; only set false for a local Postgres

# ── Database (Supabase PostgreSQL) ──
# Use the Supabase *connection string* (Project Settings → Database). Leave empty in development to use the
# embedded PGlite database (.data/pglite).
DATABASE_URL=
DB_POOL_MAX=10                  # keep small (5-10) when using the Supabase pooler

# ── Supabase (server-side only) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=              # not used by the API; reserved
SUPABASE_SERVICE_ROLE_KEY=      # NEVER expose to the browser. Used only for private Storage access.
SUPABASE_BUCKET_PROFILE=profile-photos
SUPABASE_BUCKET_KYC=kyc-documents
SUPABASE_BUCKET_SUPPORT=support-attachments

# ── Auth ──
JWT_SECRET=                     # 32+ random chars (e.g. `openssl rand -base64 48`)
JWT_REFRESH_SECRET=             # different from JWT_SECRET; also derives the key that encrypts TOTP secrets
COOKIE_SECURE=false             # must be true in staging/production
COOKIE_DOMAIN=
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
ADMIN_ACCESS_TOKEN_TTL_SEC=600
ADMIN_IDLE_MINUTES=30
ADMIN_SESSION_HOURS=8
WEBAUTHN_RP_ID=                 # defaults to the hostname of APP_URL

# ── Email (Resend) ──
RESEND_API_KEY=                 # empty => emails are only logged (never claimed as delivered)
RESEND_FROM_EMAIL=EWB Bank <no-reply@your-verified-domain.example>
SUPPORT_EMAIL=support@your-domain.example

# ── Identity verification ──
IDENTITY_PROVIDER=manual        # manual (document review by staff) | webhook (external KYC vendor)
IDENTITY_WEBHOOK_SECRET=        # HMAC secret shared with the vendor; required for POST /api/verification/webhook

# ── Ledger ──
LEDGER_MODE=simulated           # "live" is refused until real PaymentProvider/BankingProvider implementations exist
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP
LARGE_ADJUSTMENT_MINOR=100000000   # adjustments at/above this (in minor units) alert security admins
MAX_ADJUSTMENT_MINOR=10000000000
MAX_TRANSFER_MINOR=5000000

# ── Misc ──
RATE_LIMIT_ENABLED=true
ALLOW_SEED=false                # dev seed script refuses to run unless true (defaults to true outside production)
LOG_LEVEL=info
