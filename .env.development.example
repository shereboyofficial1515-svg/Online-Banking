# Development: zero-config works without any of this (embedded PGlite DB, console email, generated dev secrets in .data/).
# Copy to backend/.env only if you want to point at real Supabase/Resend from your machine.
NODE_ENV=development
APP_URL=http://localhost:5173
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
LEDGER_MODE=simulated
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:6543/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# JWT_SECRET=
# JWT_REFRESH_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=EWB Bank <no-reply@your-verified-domain.example>
