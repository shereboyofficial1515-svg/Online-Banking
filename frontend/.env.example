# Frontend environment (Vite). ONLY variables prefixed with VITE_ are embedded in the browser bundle, so
# nothing secret may ever go here. Real values belong in Vercel → Project → Settings → Environment Variables.

# Leave EMPTY (recommended) to call the API on the same origin ("/api"): locally via the Vite proxy, and in
# production via the rewrite in vercel.json. The browser then only ever talks to your own domain.
#
# Set it only for a *direct* cross-site API (then the backend needs COOKIE_SAMESITE=none and this site's origin in
# APP_URL / CORS_ORIGINS, and the CSP in vercel.json needs the API origin in connect-src and img-src):
# VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com/api
VITE_API_BASE_URL=
